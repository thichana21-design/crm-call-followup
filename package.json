{
  "name": "crm-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:backup": "node scripts/export_db.mjs",
    "db:restore": "node scripts/import_db.mjs",
    "import": "python3 scripts/export_xlsx.py && node scripts/seed.mjs",
    "import:add": "python3 scripts/export_xlsx.py && IMPORT_MODE=append node scripts/seed.mjs",
    "users": "node scripts/seed_users.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "exceljs": "^4.4.0",
    "next": "^15.5.19",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  }
}
