# ===== ฐานข้อมูล (Supabase Postgres) =====
DATABASE_URL="postgresql://...pooler..."
DIRECT_URL="postgresql://...direct..."

# ===== ความปลอดภัย =====
AUTH_SECRET="<สุ่มยาวๆ>"
CRON_SECRET="<สุ่มยาวๆ>"

# ===== Telegram (แจ้งเตือน + ส่งรหัสผ่าน) =====
TELEGRAM_BOT_TOKEN="<token จาก @BotFather>"

# ===== SMS gateway (ส่ง SMS จริงถึงมือถือลูกค้า) =====
# เลือกผู้ให้บริการ 1 อย่าง แล้วใส่เฉพาะคีย์ของเจ้านั้น
#
# ตัวเลือก A — Thaibulksms (thaibulksms.com)
# SMS_PROVIDER="thaibulksms"
# SMS_API_KEY="<API Key>"
# SMS_API_SECRET="<API Secret>"
# SMS_SENDER="<ชื่อผู้ส่งที่อนุมัติแล้ว>"
#
# ตัวเลือก B — THSMS (thsms.com)
# SMS_PROVIDER="thsms"
# SMS_API_TOKEN="<API Token>"
# SMS_SENDER="<ชื่อผู้ส่งที่อนุมัติแล้ว>"
#
# ตัวเลือก C — gateway อื่นที่รับ POST JSON {to,message,sender} + Bearer token
# SMS_PROVIDER="custom"
# SMS_API_URL="https://<endpoint ของผู้ให้บริการ>"
# SMS_API_TOKEN="<token>"
# SMS_SENDER="<ชื่อผู้ส่ง>"

# โซนเวลาเซิร์ฟเวอร์
TZ="Asia/Bangkok"
